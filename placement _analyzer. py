#!/usr/bin/env python3
"""
Placement Data Analyzer
-----------------------------------
Analyses campus placement data from a CSV file and reports:
  * number of placed students, average and highest package
  * branch-wise placements and branch-wise average package
  * students placed above a given package limit
and presents the results with Matplotlib charts (bar + pie).

CSV columns : Student, Branch, Company, Package_LPA   (placed students only)
Packages are in lakhs per annum (LPA).

Usage:
    python placement_analyzer.py                      # uses placement.csv
    python placement_analyzer.py my_data.csv          # custom file
    python placement_analyzer.py my_data.csv --limit 7  # default limit for option 2
"""

import argparse
import os
import sys

import matplotlib

# Fall back to a non-interactive backend when no display is available
# (e.g. SSH / CI). Charts are always saved as PNG files either way.
if sys.platform.startswith("linux") and not os.environ.get("DISPLAY") \
        and not os.environ.get("WAYLAND_DISPLAY"):
    matplotlib.use("Agg")

import matplotlib.pyplot as plt  # noqa: E402  (must come after backend selection)
import pandas as pd  # noqa: E402

COLUMNS = ["Student", "Branch", "Company", "Package_LPA"]
CHART_DIR = "charts"
DEFAULT_LIMIT = 7.0


# --------------------------------------------------------------------------
# 1. Loading and cleaning
# --------------------------------------------------------------------------
def load_and_clean(path):
    """Read the CSV with Pandas and return a cleaned DataFrame.

    Invalid rows (missing fields, non-numeric or non-positive package) and
    duplicate rows are dropped. Messages are printed for every skipped row.
    Returns (clean_df, number_of_rows_read).
    """
    if not os.path.isfile(path):
        sys.exit(f"Error: file '{path}' not found.")

    try:
        # header=None + dtype=str so we can report bad values exactly as typed
        raw = pd.read_csv(path, header=None, dtype=str,
                          skipinitialspace=True, keep_default_na=False)
    except pd.errors.EmptyDataError:
        sys.exit(f"Error: file '{path}' is empty.")

    # Drop the header line if the file has one
    if not raw.empty and raw.iloc[0, 0].strip().lower() == "student":
        raw = raw.iloc[1:]

    raw = raw.reset_index(drop=True)
    if raw.shape[1] < len(COLUMNS):
        sys.exit("Error: CSV must have columns: " + ", ".join(COLUMNS))
    raw = raw.iloc[:, :len(COLUMNS)]
    raw.columns = COLUMNS
    for col in COLUMNS:
        raw[col] = raw[col].str.strip()

    valid_rows = []
    for i, row in raw.iterrows():
        row_no = i + 1  # 1-based data row number (header not counted)

        if not row["Student"] or not row["Branch"] or not row["Company"]:
            print(f"Row {row_no} skipped: missing Student/Branch/Company.")
            continue

        try:
            package = float(row["Package_LPA"])
        except ValueError:
            print(f"Row {row_no} skipped: invalid Package '{row['Package_LPA']}'.")
            continue

        if package != package or package in (float("inf"), float("-inf")):
            print(f"Row {row_no} skipped: invalid Package '{row['Package_LPA']}'.")
            continue
        if package <= 0:
            print(f"Row {row_no} skipped: Package must be positive.")
            continue

        valid_rows.append({"Student": row["Student"],
                           "Branch": row["Branch"].upper(),
                           "Company": row["Company"],
                           "Package_LPA": package})

    df = pd.DataFrame(valid_rows, columns=COLUMNS)

    # Remove duplicate rows (same student in the same branch counted once)
    before = len(df)
    key = df["Student"].str.lower() + "|" + df["Branch"].str.lower()
    df = df[~key.duplicated(keep="first")].reset_index(drop=True)
    dupes = before - len(df)
    if dupes:
        print(f"{dupes} duplicate row(s) removed.")

    rows_read = len(raw)
    if len(df) != rows_read:
        print(f"Valid records: {len(df)} | Total placed: {len(df)}")
    return df, rows_read


# --------------------------------------------------------------------------
# 2. Analysis functions
# --------------------------------------------------------------------------
def summary_stats(df):
    """Total placed, average package and the top-package student."""
    top = df.loc[df["Package_LPA"].idxmax()]
    return {
        "total": len(df),
        "average": df["Package_LPA"].mean(),
        "highest": top["Package_LPA"],
        "top_student": top["Student"],
        "top_company": top["Company"],
    }


def students_above(df, limit):
    """Boolean filtering: students with a package strictly above `limit`."""
    return df[df["Package_LPA"] > limit]


def branch_analysis(df):
    """groupby(): placement count and average package per branch."""
    grouped = df.groupby("Branch")["Package_LPA"].agg(["count", "mean"])
    return grouped.rename(columns={"count": "Placements", "mean": "Average"})


# --------------------------------------------------------------------------
# 3. Charts
# --------------------------------------------------------------------------
def _finish(fig, filename):
    os.makedirs(CHART_DIR, exist_ok=True)
    out = os.path.join(CHART_DIR, filename)
    fig.tight_layout()
    fig.savefig(out, dpi=120)
    print(f"[chart saved: {out}]")
    if "agg" not in matplotlib.get_backend().lower():
        plt.show()
    plt.close(fig)


def bar_student_packages(df):
    """Bar chart: package of every placed student."""
    fig, ax = plt.subplots(figsize=(8, 5))
    bars = ax.bar(df["Student"], df["Package_LPA"], color="#4C78A8")
    ax.bar_label(bars, fmt="%.2f", padding=2)
    ax.set_title("Package of Placed Students")
    ax.set_xlabel("Student")
    ax.set_ylabel("Package (LPA)")
    ax.margins(y=0.12)
    _finish(fig, "student_packages_bar.png")


def pie_branch_placements(branch_df):
    """Pie chart: share of placements per branch."""
    fig, ax = plt.subplots(figsize=(6, 6))
    ax.pie(branch_df["Placements"], labels=branch_df.index,
           autopct=lambda p: f"{p:.0f}%", startangle=90,
           wedgeprops={"edgecolor": "white"})
    ax.set_title("Branch-wise Placements")
    _finish(fig, "branch_placements_pie.png")


def bar_branch_average(branch_df):
    """Bar chart: average package per branch."""
    fig, ax = plt.subplots(figsize=(7, 5))
    bars = ax.bar(branch_df.index, branch_df["Average"], color="#F58518")
    ax.bar_label(bars, fmt="%.2f", padding=2)
    ax.set_title("Branch-wise Average Package")
    ax.set_xlabel("Branch")
    ax.set_ylabel("Average Package (LPA)")
    ax.margins(y=0.12)
    _finish(fig, "branch_average_bar.png")


# --------------------------------------------------------------------------
# 4. Menu options
# --------------------------------------------------------------------------
def option_summary(df):
    s = summary_stats(df)
    print(f"Total placed: {s['total']} | Average package: {s['average']:.2f} LPA")
    print(f"Highest: {s['highest']:.2f} LPA ({s['top_student']}, {s['top_company']})")
    bar_student_packages(df)


def option_branchwise(df, limit):
    branch_df = branch_analysis(df)
    print("Placements: " +
          " | ".join(f"{b}: {int(r.Placements)}" for b, r in branch_df.iterrows()))
    print("Average package: " +
          " | ".join(f"{b} {r.Average:.2f}" for b, r in branch_df.iterrows()))

    above = students_above(df, limit)
    label = f"{limit:g}"
    if above.empty:
        print(f"Above {label} LPA: none")
    else:
        print(f"Above {label} LPA: " +
              " | ".join(f"{r.Student} ({r.Package_LPA:.2f})" for r in above.itertuples()))

    pie_branch_placements(branch_df)
    bar_branch_average(branch_df)


def ask_limit(default):
    try:
        text = input(f"Enter package limit in LPA [{default:g}]: ").strip()
    except EOFError:
        return default
    if not text:
        return default
    try:
        value = float(text)
    except ValueError:
        print(f"Invalid limit '{text}', using {default:g}.")
        return default
    return value


def main():
    parser = argparse.ArgumentParser(description="Placement Data Analyzer")
    parser.add_argument("csv", nargs="?", default="placement.csv",
                        help="path to the placement CSV (default: placement.csv)")
    parser.add_argument("--limit", type=float, default=DEFAULT_LIMIT,
                        help="default package limit for option 2 (default: 7)")
    args = parser.parse_args()

    df, _ = load_and_clean(args.csv)
    if df.empty:
        sys.exit("No valid placement records found.")

    while True:
        print("\n===== Placement Data Analyzer =====")
        print("1. Summary (total, average, highest)")
        print("2. Branch-wise analysis and filter above a package")
        print("3. Exit")
        try:
            choice = input("Menu option: ").strip()
        except EOFError:
            break

        if choice == "1":
            option_summary(df)
        elif choice == "2":
            limit = ask_limit(args.limit)
            option_branchwise(df, limit)
        elif choice == "3":
            print("Goodbye!")
            break
        else:
            print("Invalid option. Please enter 1, 2 or 3.")


if __name__ == "__main__":
    main()