

def bar_branch_average(branch_df):
    """Bar chart: average package per branch."""
    fig, ax = plt.subplots(figsize=(7, 5))
    bars = ax.bar(branch_df.index, branch_df["Average"], color="#F58518")
    ax.bar_label(bars, fmt="%.2f", padding=2)
    ax.set_title("Branch-wise Average Package")
    ax.set_xlabel("Branch")
    ax.set_ylabel("Average Package (LPA)")
    ax.margins(y=0.12)
    _finish(fig, "branch_average_bar.png")


